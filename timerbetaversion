void render( int xa){

  byte smbl;

  if(xa < 1){ smbl = 0b00000000;}
   else if (xa >= 1 and xa < 2){ smbl = 0b00001100;}
   else if (xa >= 2 and xa < 3){ smbl = 0b11011010;}
   else if (xa >= 3 and xa < 4){ smbl = 0b11110010;}
   else if (xa >= 4 and xa < 5){ smbl = 0b01100110;}
   else if (xa >= 5 and xa < 6){ smbl = 0b10110110;}
   else if (xa >= 6 and xa < 7){ smbl = 0b10111110;}
   else if (xa >= 7 and xa < 8){ smbl = 0b11100000;}
   else if (xa >= 8 and xa< 9){ smbl =  0b11111110;}
   else{ smbl = 0b11110110 ;}

   shiftOut(12  , 11  , LSBFIRST  , smbl);
}




