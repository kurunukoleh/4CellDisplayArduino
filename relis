void ifer(char xa){
  if (xa < 1){print0();}
   else if (xa >= 1 and xa < 2){print1();}
   else if (xa >= 2 and xa < 3){print2();}
   else if (xa >= 3 and xa < 4){print3();}
   else if (xa >= 4 and xa < 5){print4();}
   else if (xa >= 5 and xa < 6){print5();}
   else if (xa >= 6 and xa < 7){print6();}
   else if (xa >= 7 and xa < 8){print7();}
   else if (xa >= 8 and xa< 9){print8();}
   else{print9();}
}
  
